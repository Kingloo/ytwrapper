{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ytwrapper",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0/ytwrapper.dll",
            "args": [
				"https://www.pornhub.com/view_video.php?viewkey=6a6ab3d8d5ea2"
			],
			"env": {
				"Environment": "Development"
			},
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}